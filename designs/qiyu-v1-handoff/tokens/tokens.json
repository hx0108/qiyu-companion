{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "product": "栖语",
    "version": "1.2",
    "source": "栖语 V1.2 高保真原型与 Figma Variables",
    "starterPlanFallback": "Day 与 Night 在 Figma 中拆为两个单模式集合"
  },
  "color": {
    "primitive": {
      "paper": { "$value": "#F3EEE6", "$type": "color" },
      "paper2": { "$value": "#ECE4D9", "$type": "color" },
      "paper3": { "$value": "#FBF8F2", "$type": "color" },
      "ink": { "$value": "#2C2028", "$type": "color" },
      "muted": { "$value": "#796D74", "$type": "color" },
      "plum": { "$value": "#5B3653", "$type": "color" },
      "plum2": { "$value": "#74506B", "$type": "color" },
      "rose": { "$value": "#BD8F94", "$type": "color" },
      "roseSoft": { "$value": "#EAD8D4", "$type": "color" },
      "night": { "$value": "#120F18", "$type": "color" },
      "night2": { "$value": "#211724", "$type": "color" },
      "nightInk": { "$value": "#F6EEE9", "$type": "color" },
      "nightMuted": { "$value": "#C8B8BF", "$type": "color" },
      "success": { "$value": "#526A5A", "$type": "color" },
      "danger": { "$value": "#9D4C56", "$type": "color" },
      "gold": { "$value": "#9B7A52", "$type": "color" }
    },
    "day": {
      "bgCanvas": { "$value": "{color.primitive.paper}", "$type": "color" },
      "bgSubtle": { "$value": "{color.primitive.paper2}", "$type": "color" },
      "bgElevated": { "$value": "{color.primitive.paper3}", "$type": "color" },
      "textPrimary": { "$value": "{color.primitive.ink}", "$type": "color" },
      "textSecondary": { "$value": "{color.primitive.muted}", "$type": "color" },
      "actionPrimary": { "$value": "{color.primitive.plum}", "$type": "color" },
      "actionSecondary": { "$value": "{color.primitive.roseSoft}", "$type": "color" }
    },
    "night": {
      "bgCanvas": { "$value": "{color.primitive.night}", "$type": "color" },
      "bgSurface": { "$value": "{color.primitive.night2}", "$type": "color" },
      "textPrimary": { "$value": "{color.primitive.nightInk}", "$type": "color" },
      "textSecondary": { "$value": "{color.primitive.nightMuted}", "$type": "color" },
      "actionPrimary": { "$value": "#7D526D", "$type": "color" }
    }
  },
  "space": {
    "1": { "$value": "4px", "$type": "dimension" },
    "2": { "$value": "8px", "$type": "dimension" },
    "3": { "$value": "12px", "$type": "dimension" },
    "4": { "$value": "16px", "$type": "dimension" },
    "5": { "$value": "20px", "$type": "dimension" },
    "6": { "$value": "24px", "$type": "dimension" },
    "8": { "$value": "32px", "$type": "dimension" },
    "10": { "$value": "40px", "$type": "dimension" },
    "12": { "$value": "48px", "$type": "dimension" }
  },
  "radius": {
    "sm": { "$value": "8px", "$type": "dimension" },
    "md": { "$value": "12px", "$type": "dimension" },
    "lg": { "$value": "16px", "$type": "dimension" },
    "xl": { "$value": "20px", "$type": "dimension" },
    "2xl": { "$value": "24px", "$type": "dimension" },
    "sheet": { "$value": "28px", "$type": "dimension" },
    "phone": { "$value": "44px", "$type": "dimension" },
    "full": { "$value": "999px", "$type": "dimension" }
  },
  "size": {
    "touchMin": { "$value": "44px", "$type": "dimension" },
    "screenWidth": { "$value": "393px", "$type": "dimension" },
    "screenHeight": { "$value": "852px", "$type": "dimension" },
    "legacyPrototypeWidth": { "$value": "390px", "$type": "dimension" },
    "legacyPrototypeHeight": { "$value": "844px", "$type": "dimension" }
  },
  "font": {
    "serif": { "$value": "Noto Serif SC", "$type": "fontFamily" },
    "sans": { "$value": "Noto Sans SC", "$type": "fontFamily" }
  }
}
