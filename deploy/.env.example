# 栖语封测环境配置：复制为 deploy/.env 并填入真实值；.env 不入库。
# 除 POSTGRES_PASSWORD 外全部可选——留空的能力保持关闭（生产门禁语义）。

# --- 数据库 ---
POSTGRES_DB=qiyu
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-password
# API 对外宿主端口（与同机其他服务错开，如 3001）
API_PORT=3000

# --- 文字对话（Qwen）---
QIYU_LLM_PROVIDER=
QWEN_API_KEY=
# 封闭试用：设为 invite 后仅允许运营线下签发的邀请码 + 初始口令登录。
# 不会启用公开注册、短信或真实支付。
QIYU_TRIAL_AUTH=

# --- 文本审核（腾讯 TMS）---
QIYU_TEXT_MODERATION_PROVIDER=
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_TEXT_MODERATION_BIZ_TYPE=

# --- 语音（可选）---
QIYU_TTS_PROVIDER=
QIYU_ASR_PROVIDER=
QIYU_PRIVATE_MEDIA_STORE=
TENCENT_TTS_VOICE_TYPE=
TENCENT_TTS_VOICE_VERSION=
TENCENT_TTS_AUTHORIZATION_RECORD_ID=
TENCENT_TTS_RIGHTS_REVIEW_ID=
TENCENT_TTS_MODEL_TYPE=
TENCENT_TTS_SAMPLE_RATE=
TENCENT_ASR_ENGINE_MODEL_TYPE=

# --- 受控图片（可选；三项齐备才启用）---
QIYU_IMAGE_PROVIDER=
QIYU_IMAGE_MODERATION_PROVIDER=
TENCENT_HUNYUAN_REGION=ap-guangzhou
TENCENT_COS_BUCKET=
TENCENT_COS_REGION=ap-guangzhou
TENCENT_COS_ENDPOINT=
TENCENT_IMAGE_MODERATION_BIZ_TYPE=
TENCENT_IMAGE_MODERATION_URL_EXPIRES_SECONDS=120

# --- 运营审核员身份（格式 token:reviewer_id,token2:reviewer_id2）---
QIYU_REVIEWER_TOKENS=
