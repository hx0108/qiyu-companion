# 栖语封测环境配置：复制为 deploy/.env 并填入真实值；.env 不入库。
# 除 POSTGRES_PASSWORD 外全部可选——留空的能力保持关闭（生产门禁语义）。

# --- 数据库 ---
POSTGRES_DB=qiyu
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-password
# API 对外宿主端口（与同机其他服务错开，如 3001）
API_PORT=3000

# --- 文字对话（Qwen）---
QIYU_LLM_PROVIDER=
QWEN_API_KEY=
# 封闭试用：设为 invite 后仅允许运营线下签发的邀请码 + 初始口令登录。
# 不会启用公开注册、短信或真实支付。
QIYU_TRIAL_AUTH=

# --- 真实短信登录（与 invite 封测登录二选一）---
# 仅在腾讯云签名、模板均审核通过，并准备本人测试号码验收后启用。
QIYU_SMS_PROVIDER=
QIYU_SMS_SDK_APP_ID=
QIYU_SMS_SIGN_NAME=
QIYU_SMS_TEMPLATE_ID=

# --- 文本审核（腾讯 TMS）---
QIYU_TEXT_MODERATION_PROVIDER=
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_TEXT_MODERATION_BIZ_TYPE=

# --- 语音（可选）---
QIYU_TTS_PROVIDER=
QIYU_ASR_PROVIDER=
QIYU_PRIVATE_MEDIA_STORE=
TENCENT_TTS_VOICE_TYPE=
TENCENT_TTS_VOICE_VERSION=
TENCENT_TTS_AUTHORIZATION_RECORD_ID=
TENCENT_TTS_RIGHTS_REVIEW_ID=
TENCENT_TTS_MODEL_TYPE=
TENCENT_TTS_SAMPLE_RATE=
TENCENT_ASR_ENGINE_MODEL_TYPE=

# --- 受控图片（可选；三项齐备才启用）---
QIYU_IMAGE_PROVIDER=
QIYU_IMAGE_MODERATION_PROVIDER=
TENCENT_HUNYUAN_REGION=ap-guangzhou
TENCENT_COS_BUCKET=
TENCENT_COS_REGION=ap-guangzhou
TENCENT_COS_ENDPOINT=
TENCENT_IMAGE_MODERATION_BIZ_TYPE=
TENCENT_IMAGE_MODERATION_URL_EXPIRES_SECONDS=120

# --- 运营审核员身份（格式 token:reviewer_id,token2:reviewer_id2）---
QIYU_REVIEWER_TOKENS=

# --- 成本估算与告警 ---
# JSON 示例：{"qwen":{"input_fen_per_1k":0.08,"output_fen_per_1k":0.27}}
# 金额单位为人民币分；供应商账单对账后才可作为正式结算证据。
QIYU_COST_RATE_CARD_JSON=
QIYU_ALERT_P99_LATENCY_MS=15000
QIYU_ALERT_FAILURE_RATE=0.05
QIYU_ALERT_UNIT_COST_FEN=

# 监控栈（docker-compose.monitoring.yml）：Grafana 管理口令与个人告警渠道
GRAFANA_ADMIN_PASSWORD=HP-dmdqqTuUZvF6p
ALERT_PUSH_WEBHOOK_URL=
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=587
ALERT_SMTP_FROM=
ALERT_SMTP_TO=
