+  const includesMetadata = Object.hasOwn(event, 'metadata');
+  return (relationship || event.event_type === 'access_info_viewed') &&
+    typeof event.event_id === 'string' && uuid.test(event.event_id) &&
+    Object.keys(event).length === (relationship ? 3 : 2) + Number(includesMetadata) &&
+    (!includesMetadata || validTrialBehaviorMetadata(event.metadata)) &&
+    (relationship ? typeof event.character_id === 'string' && uuid.test(event.character_id) : !Object.hasOwn(event, 'character_id'));
