+function validTrialBehaviorMetadata(metadata) {
+  if (!metadata || typeof metadata !== 'object' || Array.isArray(metadata) || Object.keys(metadata).length !== 3 ||
+      !['home', 'chat', 'profile', 'data', 'assets', 'subscription', 'other'].includes(metadata.entry_surface) ||
