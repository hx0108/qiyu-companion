+    assistantMessage[effectiveChatSource] = userMessage.message_id;
+    if (startedAt !== null) assistantMessage[effectiveChatStartedAt] = startedAt;
+    if (sessionKey !== null) assistantMessage[effectiveChatSessionKey] = sessionKey;
+  }
+}
+
+module.exports = { effectiveChatSource, effectiveChatStartedAt, effectiveChatSessionKey, markEffectiveChatTurn };
