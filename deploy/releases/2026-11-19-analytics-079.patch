+      WHERE account_id = $1 AND account_status = 'OPEN' AND deleted_at IS NULL
+      ${writing ? 'FOR UPDATE' : ''}`, [accountId]);
+    const current = account.rows[0];
+    if (!current) throw Object.assign(new Error('账户当前不可用'), { status: 403, code: 'ACCOUNT_NOT_OPEN' });
+
+    let active = current.trial_behavior_enabled;
+    let processing = current.trial_relationship_processing_enabled;
+    let acceptedIds = [];
+    if (enabled !== undefined) {
+      const nextProcessing = enabled && (includeRelationshipActions === true || processing);
+      if (enabled !== active || nextProcessing !== processing) {
+        await client.query(`UPDATE accounts SET trial_behavior_enabled = $2, trial_relationship_processing_enabled = $3
